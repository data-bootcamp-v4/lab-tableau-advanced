    <worksheet name='Regression Plot'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>·The R² of </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>0.00093</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'> shows virtually no linear relationship between Income and Customer Lifetime Value.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>·The trend line is nearly flat, with a slope too small to have any real effect on CLV.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>·This suggests CLV is driven by factors other than income, such as policy type or tenure.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='we_fn_use_c_marketing_customer_value_analysis' name='federated.0jjmd0e11josml15iye6k1ikmd5r' />
          </datasources>
          <datasource-dependencies datasource='federated.0jjmd0e11josml15iye6k1ikmd5r'>
            <column datatype='integer' name='[Customer Lifetime Value]' role='measure' type='quantitative' />
            <column datatype='string' name='[Customer]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Income]' role='measure' type='quantitative' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Customer]' derivation='None' name='[none:Customer:nk]' pivot='key' type='nominal' />
            <column-instance column='[Customer Lifetime Value]' derivation='Sum' name='[sum:Customer Lifetime Value:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Income]' derivation='Sum' name='[sum:Income:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0jjmd0e11josml15iye6k1ikmd5r].[Action (State)]'>
            <groupfilter function='level-members' level='[State]' user:ui-action-filter='[Action5_6EAF900C78EA48BC915FD90C7564AA17]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.0jjmd0e11josml15iye6k1ikmd5r].[sum:Customer Lifetime Value:qk]' included-values='in-range' />
          <filter class='quantitative' column='[federated.0jjmd0e11josml15iye6k1ikmd5r].[sum:Income:qk]' included-values='in-range' />
          <slices>
            <column>[federated.0jjmd0e11josml15iye6k1ikmd5r].[Action (State)]</column>
            <column>[federated.0jjmd0e11josml15iye6k1ikmd5r].[sum:Customer Lifetime Value:qk]</column>
            <column>[federated.0jjmd0e11josml15iye6k1ikmd5r].[sum:Income:qk]</column>
