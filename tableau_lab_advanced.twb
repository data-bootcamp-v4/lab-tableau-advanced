    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Customer Statistics Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='165' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98370' id='1' param='vert' removable='false' type-v2='layout-flow' w='99064' x='468' y='815'>
            <zone h='3360' id='3' type-v2='title' w='99064' x='468' y='815' />
            <zone fixed-size='307' h='31263' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99064' x='468' y='4175' />
            <zone h='63747' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99064' x='468' y='35438'>
              <flipboard active-id='3' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Customers are equally distributed by gender.' captured-sheet='Gender Barplot' id='1' />
                  <story-point caption='Most customers are employed.' captured-sheet='Employment and Gender Barplot' id='2' />
                  <story-point caption='Most customers are married.' captured-sheet='Marital Status  Gender Cross Table' id='3' />
                  <story-point caption='Most customers live in California and Oregon.' captured-sheet='State Treeplot' id='4' />
                  <story-point caption='Customer statistics overview' captured-sheet='Dashboard Assembly ' id='9'>
                    <capturedDeltas>
                      <dashboard name='Dashboard Assembly '>
                        <zone id='3'>
                          <formatted-text>
                            <run bold='true' fontsize='22'>Customer Statistics</run>
                          </formatted-text>
                        </zone>
                      </dashboard>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Most customers live in California and Oregon.' captured-sheet='Choropleth Map' id='5' />
                  <story-point caption='CLV increases very slightly as Income increases. There is weak evidence of a relationship between income and CLV.' captured-sheet='Regression Plot' id='6' />
                  <story-point caption='Small vehicles have the highest median claim amount.Medium vehicles show the widest variation in claim amounts. All groups are right-skewed, meaning some customers file very large claims. Some claims are as low as $0–$2, likely reflecting minimal claims or deductibles.' captured-sheet='Boxplot' id='7' />
                  <story-point caption='Customer statistics overview' captured-sheet='Dashboard Assembly Advanced' id='8'>
                    <capturedDeltas>
                      <worksheet name='Choropleth Map'>
