    <dashboard name='historia de clientes' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Análisis Avanzado de Clientes</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='314' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3942' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4772' />
            <zone h='83921' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='15249'>
              <flipboard active-id='9' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Hay mas clientes mujeres que hombres' captured-sheet='genero' id='1' />
                  <story-point caption='Situacion laboral por clientes y por genero, la mayoria estan empleados o desempleados' captured-sheet='empleo-genero' id='2'>
                    <capturedDeltas>
                      <worksheet name='empleo-genero'>
                        <shelf-sort-deltas>
                          <shelf-sorts>
                            <shelf-sort-v2 dimension-to-sort='[federated.03jw76h0mi5g5z16zn77504q64y7].[none:EmploymentStatus:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.03jw76h0mi5g5z16zn77504q64y7].[ctd:Customer:qk]' shelf='columns' />
                          </shelf-sorts>
                        </shelf-sort-deltas>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Cantidad de cliente por estado, California y Oregon contienen la mitad de nuestros clientes' captured-sheet='clientes-estado' id='3' />
                  <story-point caption='Estado civil de nuestros clientes por genero, la mayoria estan casados' captured-sheet='cross: est.civil-genero' id='4' />
                  <story-point caption='Resumen del analisis general' captured-sheet='Dashboard 1' id='5' />
                  <story-point caption='Vision de los clientes por estados, como hemos dicho, California y Oregon son los estados con mas de nuestros clientes' captured-sheet='mapa: clientes por estado' id='6'>
                    <capturedDeltas>
                      <worksheet name='mapa: clientes por estado'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.03jw76h0mi5g5z16zn77504q64y7].[Latitude (generated)]' field-type='quantitative' max='6293316.2894357815' min='3346601.7257280769' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.03jw76h0mi5g5z16zn77504q64y7].[Longitude (generated)]' field-type='quantitative' max='-11332336.313976828' min='-14394389.52905651' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='No vemos una relacion entre los ingresos de nuestros clientes y el valor de vida que tienen para nosotros' captured-sheet='regresion: clv por ingreso' id='7' />
                  <story-point caption='Los vehículos grandes tienden a tener reclamaciones mas dispersas y valores mas altos, mientras que los pequeños presentan menos diferencias' captured-sheet='reclamaciones por tamaño vehiculo' id='8' />
                  <story-point caption='resumen de analisis avanzado' captured-sheet='Dashboard 2' id='9' />
                </story-points>
