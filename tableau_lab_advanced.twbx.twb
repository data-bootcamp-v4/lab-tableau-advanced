    <dashboard name='Customer Insights Story' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='1179' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98156' id='1' param='vert' removable='false' type-v2='layout-flow' w='99064' x='468' y='922'>
            <zone h='3802' id='3' type-v2='title' w='99064' x='468' y='922' />
            <zone h='11636' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99064' x='468' y='4724' />
            <zone h='82718' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99064' x='468' y='16360'>
              <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Visión general de insights avanzados&#10;Este dashboard resume tres dimensiones clave del análisis: distribución geográfica de clientes, relación entre ingresos y Customer Lifetime Value, y comportamiento de reclamaciones según tamaño del vehículo.' captured-sheet='Advanced Customer Insights Dashboard' id='1' />
                  <story-point caption='Distribución geográfica de clientes&#10;El mapa permite identificar en qué estados se concentra la mayor cantidad de clientes. Los estados con color más intenso representan mayor presencia en la base de datos.&#10;La concentración geográfica permite detectar regiones prioritarias para campañas comerciales, análisis de retención o expansión de clientes.' captured-sheet='State Choropleth Map' id='2' />
                  <story-point caption='Relación entre ingresos y valor del cliente&#10;El gráfico de regresión permite analizar si existe relación entre Income y Customer Lifetime Value.&#10;Si la línea de tendencia es ascendente, puede sugerir que clientes con mayores ingresos tienden a generar mayor valor para la empresa. Si la nube de puntos está muy dispersa, la relación puede ser débil y deberían analizarse otras variables adicionales.' captured-sheet='CLV vs Income Regression' id='3' />
                  <story-point caption='Reclamaciones por tamaño de vehículo&#10;El boxplot muestra la distribución de Total Claim Amount según Vehicle Size.&#10;La visualización permite comparar medianas, dispersión y outliers entre vehículos Large, Medsize y Small. Esto ayuda a detectar si algún tamaño de vehículo concentra reclamaciones más elevadas o más variables.' captured-sheet='Claim Amount by Vehicle Size Boxplot' id='4' />
                  <story-point caption='Conclusión general&#10;El análisis muestra que Tableau permite integrar múltiples perspectivas del cliente en una sola narrativa visual: localización geográfica, valor económico del cliente y comportamiento de reclamaciones.&#10;&#10;Estos insights pueden apoyar decisiones sobre segmentación, campañas regionales, priorización de clientes y análisis de riesgo por tipo de vehículo.' captured-sheet='Advanced Customer Insights Dashboard' id='5' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{484D0590-3869-4023-AAEC-F7B452291F91}' />
    </dashboard>
