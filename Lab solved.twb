        <zone flipboard-zone-id='5' forceUpdate='true' h='17739' id='6' story-point-id='1' type-v2='text' w='23524' x='2461' y='74170'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>The company&apos;s customers are mainly </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book' fontsize='12'>distributed across five states</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> in the southwestern United States, with California having the most customers at </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book' fontsize='12'>3,150</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, and Washington having the fewest at only </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book' fontsize='12'>798</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='25415' hidden='true' id='7' story-point-id='3' type-v2='text' w='39764' x='36614' y='65041'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Customer lifetime value and income are</run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'> linearly positively correlated</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>, meaning that </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>the higher the income, the higher the customer lifetime value.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>However, this correlation decreases as coverage increases, with </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>basic coverage having the highest correlation.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='15456' hidden='true' id='8' story-point-id='2' type-v2='text' w='41634' x='43996' y='56224'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>Large size vehicles</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> received the highest Total Claim Amount, followed by small size vehicles. </run>
            <run fontalignment='0' fontcolor='#1b1b1b' fontname='Benton Sans Book'>Midsize vehicles had the fewest claims, </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>with </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>no significant outliers</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{514A2786-41E6-40C9-9741-A38B3AB31C38}' />
    </dashboard>
