          <formatted-text>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000cc' fontname='Benton Sans Low-DPI' fontsize='9'>R-Squared:        </run>
            <run fontalignment='0' fontcolor='#000000cc' fontname='Benton Sans Low-DPI' fontsize='9'>0,0012673</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000cc' fontname='Benton Sans Low-DPI' fontsize='9'>Standard error:        </run>
            <run fontalignment='0' fontcolor='#000000cc' fontname='Benton Sans Low-DPI' fontsize='9'>30661,8</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000cc' fontname='Benton Sans Low-DPI' fontsize='9'>p-value (significance):        </run>
            <run fontalignment='0' fontcolor='#000000cc' fontname='Benton Sans Low-DPI' fontsize='9'>0,0014095</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>Minor correlation between both variables</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='35892' id='7' story-point-id='5' type-v2='text' w='50984' x='33957' y='28631'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Each box represents the interquartile range (middle 50% of the data). The line inside the box shows the median.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Whiskers extend to show the variability outside the upper and lower quartiles, and any dots beyond the whiskers indicate outliers.</run>
          </formatted-text>
        </zone>
      </zones>
