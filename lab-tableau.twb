                  <story-point caption='Income and Customer Lifetime Value' captured-sheet='Regression Plot' id='3' />
                  <story-point caption='Total Claim Amount and Vehicle Size' captured-sheet='Boxplot Analysis' id='4' />
                  <story-point caption='End' captured-sheet='' id='6' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
