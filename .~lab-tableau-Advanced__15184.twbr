    <dashboard name='Summary &amp; Recommendations' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='264' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3423' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4253' />
            <zone h='84440' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='14730'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption=' Summary &amp; Recommendations' captured-sheet='' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='35166' id='6' story-point-id='1' type-v2='text' w='92520' x='3150' y='30083'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Customer distribution varies significantly by state, with certain states having a much stronger presence.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>CLV shows almost </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>no correlation</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> with customer income, suggesting that other factors (e.g., engagement, behavior, product type) influence lifetime value.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Claim amounts increase with vehicle size, and larger vehicles show greater risk and higher variability. </run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{A4D9D3CB-F282-4350-AA6C-6B4BDB7E6410}' />
    </dashboard>
