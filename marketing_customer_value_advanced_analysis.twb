                            <encoding attr='space' class='0' field='[federated.1n8ul5f1i2g0x41bcnjpb1qsw38c].[Latitude (generated)]' field-type='quantitative' max='7243898.1424021591' min='2456304.899266433' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
