              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Geographic Insights' captured-sheet='Customer Distribution Map' id='1'>
                    <capturedDeltas>
                      <worksheet name='Customer Distribution Map'>
                        <style delta-type='added'>
